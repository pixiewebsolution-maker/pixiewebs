# Copy to .env.local (kept out of git) and fill in, or set the same variable in
# your host's environment settings (on Vercel: Project → Settings → Environment Variables).

# The site's live address, used for link previews (WhatsApp, LinkedIn, X),
# the sitemap and robots.txt. On Vercel it falls back to the project's
# production address, but set it once you have your own domain.
NEXT_PUBLIC_SITE_URL=
