# Copy to .env.local (kept out of git) and fill in, or set the same variable in
# your host's environment settings.

# Where the contact form (/contact) sends each message, as a JSON POST.
# Any service that accepts JSON works, for example a Formspree form endpoint
# (https://formspree.io/f/xxxxxxx), a Make or Zapier webhook, or your own API.
# While it's empty, the form tells visitors it isn't connected yet.
CONTACT_FORWARD_URL=
